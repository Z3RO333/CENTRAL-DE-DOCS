# Supabase (obrigatórias)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do ambiente
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Limite de upload de documentos em MB (padrão: 15)
MAX_DOCUMENT_UPLOAD_MB=15

# Azure OpenAI (opcional: análises por IA e Copiloto)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Azure OpenAI — embeddings (opcional: busca semantica de documentos)
# Pode ser o mesmo recurso do chat (deixe ENDPOINT/API_KEY em branco para
# reaproveitar AZURE_OPENAI_ENDPOINT/AZURE_OPENAI_API_KEY) ou um recurso
# dedicado, informando os dois abaixo.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_API_VERSION=
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_KEY=

# Teto diario de documentos tentados pelo backfill (protege custo de OCR).
# Omitir ou deixar em branco usa o padrao seguro de 500. Defina um numero para aumentar ou reduzir.
INDEXACAO_LIMITE_DIARIO=

# Azure Document Intelligence (opcional: OCR)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30

# Segredo do Database Webhook que dispara a analise automatica por IA
# (Supabase -> Database -> Webhooks -> header Authorization: Bearer <valor>)
DOCUMENTOS_IA_WEBHOOK_SECRET=

# Compatibilidade com nomes antigos de OCR (opcional)
AZURE_OCR_ENDPOINT=
AZURE_OCR_DOCUMENT=

# E-mail para avisos de aprovação e cobrança agendada (opcional)
SENDGRID_API_KEY=
FROM_EMAIL=
CRON_SECRET=

